<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-launchd.sh fills in __REPO__ and copies this to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>tuttemuj.extract</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/nightly-extract.sh</string>
  </array>
  <!-- 07:00 local time. If the Mac is asleep, launchd runs the job when it wakes. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/.cache/nightly-extract.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/.cache/nightly-extract.log</string>
</dict>
</plist>
