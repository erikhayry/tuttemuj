{
  "name": "@tuttemuj/crawler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "seed": "tsx src/cli/seed.ts",
    "crawl": "tsx src/cli/crawl.ts",
    "images:backfill": "tsx src/cli/images-backfill.ts",
    "gazetteer:build": "tsx src/cli/gazetteer-build.ts",
    "dates:backfill": "tsx src/cli/dates-backfill.ts",
    "entities:build": "tsx src/cli/entities-build.ts",
    "page-groups:build": "tsx src/cli/page-groups-build.ts",
    "places:geocode": "tsx src/cli/places-geocode.ts",
    "places:unlocated": "tsx src/cli/places-unlocated.ts",
    "places:unmatched": "tsx src/cli/places-unmatched.ts",
    "extract:next": "tsx src/cli/extract-next.ts",
    "extract:save": "tsx src/cli/extract-save.ts",
    "pages:mark-no-content": "tsx src/cli/pages-mark-no-content.ts",
    "images:classify": "tsx --env-file-if-exists=../../.env src/cli/images-classify.ts",
